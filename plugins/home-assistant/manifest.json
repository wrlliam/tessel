{
  "id": "home-assistant",
  "name": "Home Assistant",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Turn lights, scenes and anything else in Home Assistant on and off, and show their state on tiles.",
  "author": "Tessel",
  "main": "dist/index.js",
  "permissions": ["network"],
  "icon": "home",
  "settingsSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Home Assistant address",
        "description": "e.g. http://homeassistant.local:8123",
        "default": "http://homeassistant.local:8123"
      },
      "token": {
        "type": "string",
        "title": "Access token",
        "description": "Create a long-lived access token at the bottom of your Home Assistant profile page.",
        "secret": true,
        "default": ""
      },
      "pollSeconds": {
        "type": "number",
        "title": "Check states every (seconds)",
        "default": 5,
        "minimum": 2,
        "maximum": 300
      }
    }
  }
}
